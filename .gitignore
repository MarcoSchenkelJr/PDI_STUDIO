# --- Python / Backend ---
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.env
*.sqlite3

# --- Node.js / Frontend ---
node_modules/
dist/
dist-ssr/
*.local
coverage/

# --- IDEs e Editores ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# --- Sistema Operacional ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Arquivos de setup ---
*.pptx
*.pdf
*.docx

# --- Diretórios de dados ---
Brain/
.mimocode/
Docs/

# --- Cache ---
.cache/
.pytest_cache/
.mypy_cache/

# --- Build tools ---
*.tgz
*.tar.gz
